# === MẪU CẤU HÌNH BIẾN MÔI TRƯỜNG ===
# Sao chép file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file .env lên GitHub (đã có trong .gitignore).

# RPC URL của mạng Sepolia (lấy miễn phí tại Alchemy hoặc Infura)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Private key của ví dùng để deploy (KHÔNG dùng ví chính chứa tiền thật!)
# Lấy từ MetaMask: ... > Account details > Show private key
PRIVATE_KEY=0xyour_private_key_here
